# Copy this file to .env and fill in real values.
# Do not commit or share .env because it contains email credentials.

APP_BASE_URL=http://127.0.0.1:8001
DATA_DIR=data
SESSION_SECRET=change-this-to-a-long-random-secret

# SMTP examples:
# Postmark SMTP host: smtp.postmarkapp.com, port 587
# SendGrid SMTP host: smtp.sendgrid.net, port 587
# Gmail requires an app password and is not ideal for production.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=updates@your-domain.org
SMTP_FROM_NAME=Mission-Haiti
